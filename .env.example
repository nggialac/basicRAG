# Load a YAML profile (optional)
# BASICRAG_CONFIG=configs/business.yaml
# BASICRAG_PROFILE=business

# Chat model
# BASICRAG_LLM__PROVIDER=openai_compat
# BASICRAG_LLM__MODEL=
# BASICRAG_LLM__BASE_URL=
# BASICRAG_LLM__API_KEY=not-needed
# BASICRAG_LLM__TEMPERATURE=0.0

# Embeddings
# BASICRAG_EMBEDDINGS__PROVIDER=ollama
# BASICRAG_EMBEDDINGS__MODEL=embeddinggemma
# BASICRAG_EMBEDDINGS__CACHE=true

# Retrieval
# BASICRAG_SEARCH__STRATEGY=hybrid
# BASICRAG_SEARCH__K=8
# BASICRAG_SEARCH__FETCH_K=40
# BASICRAG_RERANK__ENABLED=true
# BASICRAG_RERANK__PROVIDER=llm

# Original flat variables are still supported
# BASICRAG_LLM_MODEL=
# BASICRAG_EMBEDDING_MODEL=embeddinggemma
# BASICRAG_RETRIEVER_K=5

# LangSmith tracing (optional)
#LANGSMITH_TRACING=
#LANGSMITH_API_KEY=
